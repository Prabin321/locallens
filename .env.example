# LocalLens - Firebase Web App Configuration Template
# Copy this file to .env.local and populate with your Firebase Web App credentials.
# In Vite, all client-exposed variables must be prefixed with VITE_.
# These variables identify your Firebase project to Google APIs and are safe for client-side web distribution.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=locallens-b4060.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=locallens-b4060
VITE_FIREBASE_STORAGE_BUCKET=locallens-b4060.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Checkpoint 3: App Check must be registered in Firebase Console for cloud calls.
# Public reCAPTCHA v3 SITE key (never the reCAPTCHA secret).
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
# Select a currently enabled Firebase AI Logic Gemini model; confirm availability/quota.
VITE_FIREBASE_AI_MODEL=gemini-2.5-flash
# NEVER put App Check debug tokens or service-account keys into VITE_ variables.
